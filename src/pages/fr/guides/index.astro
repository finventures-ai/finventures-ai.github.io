---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guides } from '../../../data/guides';
const list = guides.fr;
---
<BaseLayout lang="fr" title="Guides" description="Guides complets : Systeme.io, outils courriel gratuits, Kit vs MailerLite, vidéo IA." pathWithoutLang="/guides/">
  <section class="wrap">
    <h1>Guides</h1>
    <ul>{list.map((g) => <li><a href={`/fr/guides/${g.frontmatter.slug}/`}>{g.frontmatter.title}</a><br/><span class="muted small">{g.frontmatter.description}</span></li>)}</ul>
  </section>
</BaseLayout>
