---
import { tools } from '../../data/tools';
import { site, t } from '../../data/i18n';
import { siteConfig } from '../../data/siteConfig';

export function getStaticPaths() {
  const brands = Array.from(new Set(tools.map((x) => x.brand)));
  return brands.map((brand) => ({ params: { brand } }));
}

const brand = Astro.params.brand!;
const tool = tools.find((x) => x.brand === brand)!;
/** Affiliate when approved; otherwise official vendor page. */
const base = tool.goUrl ?? tool.website;
const withUtm = (u: string, c: string) => { const x = new URL(u); x.searchParams.set('utm_source','finventures'); x.searchParams.set('utm_medium','site'); x.searchParams.set('utm_campaign',c); return x.toString(); };
const target = tool.goUrl ? withUtm(base, 'go-' + brand) : base;
const isAff = !!tool.goUrl;
const copy = t.fr;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {siteConfig.noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <title>{tool.name.fr} — {site.name}</title>
    <script define:vars={{ target, isAff }}>
      let dest = target;
      try {
        if (isAff && document.referrer) {
          const r = new URL(document.referrer);
          if (r.host === location.host) {
            const page = r.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
            const u = new URL(target); u.searchParams.set('utm_campaign', page); dest = u.toString();
          }
        }
      } catch (e) {}
      location.replace(dest);
    </script>
  </head>
  <body style="font-family:system-ui,sans-serif;background:#0b1220;color:#e8eefc;max-width:640px;margin:3rem auto;padding:0 1rem;line-height:1.5">
    <p>{isAff ? 'Redirection vers le site officiel (lien affilié)…' : copy.goPendingBody}</p>
    <p><a href={target} rel="noopener noreferrer" style="color:#5b8cff">{tool.name.fr} — site officiel{isAff ? ' (lien affilié)' : ''}</a></p>
    <p style="font-size:0.85rem;color:#9aa8c7;margin-top:1.5rem">{copy.disclosure}</p>
  </body>
</html>
