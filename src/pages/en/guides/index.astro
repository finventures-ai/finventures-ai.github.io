---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { guides } from '../../../data/guides';
const list = guides.en;
---
<BaseLayout lang="en" title="Guides" description="In-depth guides: Systeme.io, free email tools, Kit vs MailerLite, AI video." pathWithoutLang="/guides/">
  <section class="wrap">
    <h1>Guides</h1>
    <ul>{list.map((g) => <li><a href={`/en/guides/${g.frontmatter.slug}/`}>{g.frontmatter.title}</a><br/><span class="muted small">{g.frontmatter.description}</span></li>)}</ul>
  </section>
</BaseLayout>
