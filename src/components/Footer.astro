---
import { site, t, type Lang } from '../data/i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t[lang];
const address = site.mailingAddress?.trim()
  ? site.mailingAddress
  : (lang === 'fr' ? 'à venir' : 'coming soon');
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <strong>{site.name}</strong>
      <p class="small">{copy.casl} <em>{address}</em></p>
      <p class="small">{site.email}</p>
    </div>
    <div>
      <strong>{copy.footerNav}</strong>
      <ul class="clean">
        <li><a href={`/${lang}/`}>{lang === 'fr' ? 'Accueil' : 'Home'}</a></li>
        <li><a href={`/${lang}/category/email/`}>{lang === 'fr' ? 'Courriel' : 'Email'}</a></li>
        <li><a href={`/${lang}/category/funnels/`}>{lang === 'fr' ? 'Tunnels' : 'Funnels'}</a></li>
        <li><a href={`/${lang}/category/ai/`}>{lang === 'fr' ? 'IA' : 'AI'}</a></li>
      </ul>
    </div>
    <div>
      <strong>{copy.footerLegal}</strong>
      <p class="small">{copy.disclosure}</p>
      <p class="small muted">© {new Date().getFullYear()} {site.owner} · {site.domain}</p>
    </div>
  </div>
</footer>
