---
import { site, t, type Lang } from '../data/i18n';
import Logo from './Logo.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = t[lang];
const fr = lang === 'fr';
const newsletters = [
  { href: 'https://inboxlab.substack.com', label: fr ? 'InboxLab (Courriel)' : 'InboxLab (Email)' },
  { href: 'https://funnellabstudio.substack.com', label: fr ? 'FunnelLab (Tunnels)' : 'FunnelLab (Funnels)' },
  { href: 'https://ailabfv.substack.com', label: fr ? 'AI Lab (IA)' : 'AI Lab (AI)' },
];
const socials = [
  { href: 'https://www.youtube.com/@finventuresai', label: 'YouTube Fin Ventures AI' },
  { href: 'https://www.youtube.com/@inboxlab-fv', label: 'YouTube InboxLab' },
  { href: 'https://www.instagram.com/finventuresai/', label: 'Instagram' },
  { href: 'https://www.tiktok.com/@venturesstudio295', label: 'TikTok' },
  { href: 'https://www.facebook.com/profile.php?id=61596235923284', label: 'Facebook' },
  { href: 'https://www.threads.com/@finventuresai', label: 'Threads' },
  { href: 'https://x.com/FinVenturesAi', label: 'X' },
  { href: 'https://www.linkedin.com/in/fin-ventures-ai-10b92a449/', label: 'LinkedIn' },
  { href: 'https://www.pinterest.com/finventuresai/', label: 'Pinterest' },
];
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <a class="brand" href={`/${lang}/`}><Logo /><span>Fin Ventures <b>AI</b></span></a>
      <p class="small">{fr ? 'Avis et comparatifs indépendants d’outils courriel, tunnels et IA.' : 'Independent reviews and comparisons of email, funnel and AI tools.'}</p>
      <p class="small">{copy.casl} <em>{site.mailingAddress[lang]}</em></p>
      <p class="small">{site.email}</p>
    </div>
    <div>
      <strong>{copy.footerNav}</strong>
      <ul class="clean">
        <li><a href={`/${lang}/`}>{fr ? 'Accueil' : 'Home'}</a></li>
        <li><a href={`/${lang}/category/email/`}>{fr ? 'Courriel' : 'Email'}</a></li>
        <li><a href={`/${lang}/category/funnels/`}>{fr ? 'Tunnels' : 'Funnels'}</a></li>
        <li><a href={`/${lang}/category/ai/`}>{fr ? 'IA' : 'AI'}</a></li>
        <li><a href={`/${lang}/guides/`}>Guides</a></li>
        <li><a href={fr ? "/fr/methode/" : "/en/how-we-evaluate/"}>{fr ? "Méthode" : "How we evaluate"}</a></li>
      </ul>
    </div>
    <div>
      <strong>{copy.footerNewsletters}</strong>
      <ul class="clean">
        {newsletters.map((item) => (
          <li><a href={item.href} rel="noopener noreferrer" target="_blank">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <strong>{copy.footerSocial}</strong>
      <ul class="clean">
        {socials.map((item) => (
          <li><a href={item.href} rel="noopener noreferrer" target="_blank">{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <strong>{copy.footerLegal}</strong>
      <p class="small">{copy.disclosure}</p>
      <p class="small">© {new Date().getFullYear()} {site.owner} · Fin Ventures AI</p>
    </div>
  </div>
</footer>
