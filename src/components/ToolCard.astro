---
import ToolLogo from './ToolLogo.astro';
import { t, type Lang } from '../data/i18n';
import type { Tool } from '../data/tools';
import { startingPrice } from '../data/review';
interface Props { tool: Tool; lang: Lang }
const { tool, lang } = Astro.props;
const fr = lang === 'fr';
---
<article class="tool-card">
  <div class="top"><ToolLogo website={tool.website} name={tool.name[lang]} /><div><h3><a href={`/${lang}/review/${tool.slug}/`}>{tool.name[lang]}</a></h3><span class="small muted">{startingPrice(tool, lang)}</span></div></div>
  <p>{tool.tagline[lang]}</p>
  <div class="chips">{tool.features.slice(0, 3).map((f) => <span class="chip">{f.value === false ? '✕' : '✓'} {f[lang]}</span>)}</div>
  <div class="actions">
    <a class="cta sm" href={`/go/${tool.brand}/`} rel="sponsored nofollow">{fr ? 'Essayer' : 'Try it'}</a>
    <a class="cta sm secondary" href={`/${lang}/review/${tool.slug}/`}>{fr ? 'Lire l’avis' : 'Read review'}</a>
  </div>
</article>
