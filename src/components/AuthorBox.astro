---
import type { Lang } from '../data/i18n';
interface Props { lang: Lang; updated?: string }
const { lang, updated = '2026-11-05' } = Astro.props;
const fr = lang === 'fr';
const methodHref = fr ? '/fr/methode/' : '/en/how-we-evaluate/';
---
<aside class="card author" id="methode-box">
  <div class="avatar">PB</div>
  <div>
    <strong>{fr ? 'Par Pierre Bernier · Fin Ventures AI' : 'By Pierre Bernier · Fin Ventures AI'}</strong>
    <p>{fr
      ? `Mis à jour le ${updated}. Méthode : données publiques, documentation officielle et tarifs. Essai gratuit seulement s’il a vraiment été fait. Aucune note « test terrain » inventée.`
      : `Updated ${updated}. Method: public data, official docs and pricing. Free-trial notes only when a trial was actually run. No invented hands-on scores.`}</p>
    <p><a href={methodHref}>{fr ? 'Notre méthode d’évaluation →' : 'How we evaluate →'}</a></p>
  </div>
</aside>
