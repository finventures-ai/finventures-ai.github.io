---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCapture from './EmailCapture.astro';
import Toc from './Toc.astro';
import AuthorBox from './AuthorBox.astro';
import { altSlug } from '../data/guides';
import type { Lang } from '../data/i18n';
interface Props { g: any; lang: Lang }
const { g, lang } = Astro.props;
const fm = g.frontmatter;
const Content = g.Content;
const fr = lang === 'fr';
const words = (g.rawContent?.() ?? '').split(/\s+/).length;
const mins = Math.max(3, Math.round(words / 220));
---
<BaseLayout lang={lang} title={fm.title} description={fm.description} pathWithoutLang={`/guides/${fm.slug}/`} altPathWithoutLang={`/guides/${altSlug(lang, fm.slug)}/`}>
  <section class="review-hero" slot="hero"><div class="wrap" style="max-width:calc(var(--prose) + 300px)">
    <p class="crumbs"><a href={`/${lang}/`}>{fr ? 'Accueil' : 'Home'}</a> › <a href={`/${lang}/guides/`}>Guides</a></p>
    <span class="pill" style="margin-top:1rem">Guide · {mins} min</span>
    <h1 style="margin-top:.6rem">{fm.title}</h1>
    <p class="lead">{fm.description}</p>
    <div class="meta"><span>{fr ? 'Par Pierre Bernier' : 'By Pierre Bernier'}</span><span>{fr ? 'Mis à jour le' : 'Updated'} {fm.updated}</span></div>
  </div></section>
  <div class="layout two">
    <Toc lang={lang} target=".guide" />
    <article class="prose guide"><Content /><AuthorBox lang={lang} updated={fm.updated} /></article>
  </div>
  <EmailCapture lang={lang} />
</BaseLayout>
