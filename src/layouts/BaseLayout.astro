---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Disclosure from '../components/Disclosure.astro';
import { site, type Lang } from '../data/i18n';
import { siteConfig } from '../data/siteConfig';
import { isIndexedPath } from '../data/indexPolicy';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pathWithoutLang?: string;
  noindex?: boolean;
  /** Path (without lang) of the translated page when its slug differs */
  altPathWithoutLang?: string;
  wide?: boolean;
  bodyClass?: string;
}
const { lang, title, description, pathWithoutLang = '/', altPathWithoutLang, bodyClass = '' } = Astro.props;
const indexed = isIndexedPath(pathWithoutLang);
const noindex = Astro.props.noindex ?? (siteConfig.noindex || !indexed);
const canonical = new URL(`/${lang}${pathWithoutLang === '/' ? '/' : pathWithoutLang}`, Astro.site);
const alt = lang === 'fr' ? 'en' : 'fr';
const altPath = altPathWithoutLang ?? pathWithoutLang;
const altUrl = new URL(`/${alt}${altPath === '/' ? '/' : altPath}`, Astro.site);
const fullTitle = `${title} | ${site.name}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="GTwv6dZqB08G95-0LWTGYnidbs2bSsqOIyz8NMNsbW4" />
    <meta name="p:domain_verify" content="81657f15932bf555a9f94a5211458510" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.owner} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alt} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL('/fr/', Astro.site)} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#4f46e5" />
    <link rel="preconnect" href="https://www.google.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class={bodyClass}>
    <Header lang={lang} pathWithoutLang={altPath} />
    <slot name="hero" />
    <main class="wrap">
      <Disclosure lang={lang} />
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
